{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/project/new",
      "destination": "/index.html"
    },
    {
      "source": "/project/drafts",
      "destination": "/index.html"
    },
    {
      "source": "/project/edit/:id",
      "destination": "/index.html"
    }
  ]
}
